PREFIX ex: <http://amaturis.org/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?sujeto ?nombre ?precio ?moneda ?capacidad ?duracion
WHERE {
  ?sujeto rdf:type ex:PaqueteTuristico .
  ?sujeto rdfs:label ?nombre .
  
  # Navegación hacia la Especificación de precio
  OPTIONAL {
    ?sujeto ex:tienePrecio ?precioSpec .
    ?precioSpec ex:precioPorPersona ?precio . # Esta es la clave
    OPTIONAL { ?precioSpec ex:moneda ?moneda . }
  }
  
  # Detalles adicionales
  OPTIONAL { ?sujeto ex:capacidadMaxPersonas ?capacidad . }
  OPTIONAL { ?sujeto ex:duracionDias ?duracion . }
  
  # Filtro para la búsqueda del chatbot
  FILTER(CONTAINS(LCASE(STR(?nombre)), LCASE("${busqueda}")))
}