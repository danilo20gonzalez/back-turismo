PREFIX ex: <http://amaturis.org/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?reserva ?paquete_id ?fecha ?personas ?estado ?precio_unitario ?comunidad_nombre ?total_pagar
WHERE {
  # Buscamos la reserva y sus datos básicos
  ?reserva rdf:type ex:Reserva ;
           ex:reservaPaquete ?paquete ;
           ex:fechaInicio ?fecha ;
           ex:numeroViajeros ?personas ;
           ex:tieneEstado ?estado .
  
  # Filtramos por el usuario usando la propiedad que confirmamos en Fuseki
  ?reserva ex:realizaReserva <${user_id}> .

  # Extraemos el ID del paquete para el frontend
  BIND(STRAFTER(STR(?paquete), "#") AS ?paquete_id)

  # Datos opcionales
  OPTIONAL {
    ?paquete ex:precioPersona ?precio_unitario .
    BIND(?precio_unitario * ?personas AS ?total_pagar)
  }
  
  OPTIONAL {
    ?owner ex:armaPaqueteModificado ?paquete .
    OPTIONAL { ?owner rdfs:label ?ownerLabel . }
    OPTIONAL { ?owner ex:nombre ?ownerName . }
    BIND(COALESCE(?ownerLabel, ?ownerName, STRAFTER(STR(?owner), "#")) AS ?comunidad_nombre)
  }
}
ORDER BY DESC(?fecha)
